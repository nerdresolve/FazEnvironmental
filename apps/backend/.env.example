# SMTP credentials for sending lead notification emails.
# Leave unset to skip email sending (leads are still saved to data/leads.json).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-sending-address@gmail.com

# Recipient for lead notifications. Defaults to flavioaugusto0209@gmail.com if unset.
LEAD_EMAIL_TO=flavioaugusto0209@gmail.com

PORT=3001
