!apps/backend/data/consent-logs/.gitkeep
apps/backend/data/leads.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS files
Thumbs.db
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
